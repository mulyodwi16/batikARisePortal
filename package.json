{
  "name": "websitebatikarise",
  "version": "1.0.0",
  "description": "Website landing page untuk aplikasi BatikAR - Aplikasi pembelajaran motif Batik Jetis Sidoarjo menggunakan teknologi Augmented Reality dan Artificial Intelligence.",
  "main": "script.js",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./src/output.css",
    "watch": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "sync": "node tools/sync-motifs.mjs",
    "serve": "node --eval \"import('node:http').then(h=>import('node:fs').then(f=>import('node:path').then(p=>h.createServer((q,s)=>{let fp=p.join(process.cwd(),decodeURIComponent(q.url.split('?')[0]));if(fp.endsWith('/')||!p.extname(fp))fp=p.join(fp,'index.html');f.readFile(fp,(e,d)=>{if(e){s.statusCode=404;return s.end('404')}const t={'.html':'text/html','.js':'text/javascript','.json':'application/json','.png':'image/png','.jpg':'image/jpeg','.webp':'image/webp','.css':'text/css'}[p.extname(fp)]||'application/octet-stream';s.setHeader('content-type',t);s.end(d)})}).listen(5173,()=>console.log('http://localhost:5173')))))\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com-batikar:mulyodwi16/batikARisePortal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14"
  }
}
