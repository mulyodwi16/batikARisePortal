# Kredensial untuk `npm run sync`. Salin file ini jadi `.env` lalu isi nilainya.
# `.env` sudah masuk .gitignore, jangan pernah di-commit.
#
# Login anonim (LoginWithCustomID) DIMATIKAN di title ini — PlayFab menolak
# dengan "PlayerCreationDisabled" (errorCode 22000) — jadi sinkronisasi wajib
# memakai akun PlayFab yang sudah terdaftar.
#
# Di GitHub Actions, dua nilai ini dipasok lewat repository secrets dengan nama
# yang sama (Settings > Secrets and variables > Actions).

PLAYFAB_EMAIL=
PLAYFAB_PASSWORD=
